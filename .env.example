# ==========================================
# WATCHA Backend Environment Configuration
# ==========================================

# Node Environment
NODE_ENV=production

# Server Port & Host
PORT=10000
HOST=0.0.0.0

# TMDB Authentication (REQUIRED)
# Set your v3/v4 Read Access Token here (Bearer token)
TMDB_READ_ACCESS_TOKEN=your_tmdb_read_access_token_here

# Allowed CORS Origins (comma-separated or * for public mobile API)
ALLOWED_ORIGINS=*

# Optional Redis Cache (Leave empty to use high-performance in-memory cache)
REDIS_URL=

# Stremio Addon Configuration (Optional default manifest)
DEFAULT_STREMIO_ADDON_URL=https://torrentio.strem.fun/manifest.json

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
